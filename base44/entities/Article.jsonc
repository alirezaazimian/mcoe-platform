{
  "name": "Article",
  "type": "object",
  "properties": {
    "title_fa": {
      "type": "string",
      "title": "\u0639\u0646\u0648\u0627\u0646 (\u0641\u0627\u0631\u0633\u06cc)"
    },
    "title_en": {
      "type": "string",
      "title": "Title (English)"
    },
    "summary_fa": {
      "type": "string",
      "title": "\u062e\u0644\u0627\u0635\u0647 (\u0641\u0627\u0631\u0633\u06cc)"
    },
    "summary_en": {
      "type": "string",
      "title": "Summary (English)"
    },
    "body_fa": {
      "type": "string",
      "title": "\u0645\u062a\u0646 (\u0641\u0627\u0631\u0633\u06cc)",
      "format": "text"
    },
    "body_en": {
      "type": "string",
      "title": "Body (English)",
      "format": "text"
    },
    "featured_image": {
      "type": "string",
      "title": "Featured Image URL"
    },
    "category": {
      "type": "string",
      "title": "Category",
      "enum": [
        "education",
        "parenting",
        "pedagogy",
        "psychology",
        "general"
      ],
      "default": "general"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Tags"
    },
    "author_name": {
      "type": "string",
      "title": "Author Name"
    },
    "reading_time_min": {
      "type": "integer",
      "title": "Reading Time (min)",
      "default": 5
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "draft",
        "pending_review",
        "approved",
        "published",
        "archived"
      ],
      "default": "draft"
    },
    "publish_date": {
      "type": "string",
      "format": "date",
      "title": "Publish Date"
    },
    "slug_fa": {
      "type": "string",
      "title": "Slug (FA)"
    },
    "slug_en": {
      "type": "string",
      "title": "Slug (EN)"
    },
    "is_featured": {
      "type": "boolean",
      "default": false,
      "title": "Featured"
    }
  },
  "required": [
    "title_fa"
  ]
}