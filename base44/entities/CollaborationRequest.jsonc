{
  "name": "CollaborationRequest",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "title": "\u0646\u0627\u0645 \u0648 \u0646\u0627\u0645 \u062e\u0627\u0646\u0648\u0627\u062f\u06af\u06cc"
    },
    "email": {
      "type": "string",
      "format": "email",
      "title": "\u0627\u06cc\u0645\u06cc\u0644"
    },
    "phone": {
      "type": "string",
      "title": "\u0634\u0645\u0627\u0631\u0647 \u062a\u0645\u0627\u0633"
    },
    "expertise_area": {
      "type": "string",
      "title": "\u062d\u0648\u0632\u0647 \u062a\u062e\u0635\u0635\u06cc"
    },
    "resume_url": {
      "type": "string",
      "title": "\u0631\u0632\u0645\u0647 (Resume URL)",
      "format": "url"
    },
    "message": {
      "type": "string",
      "format": "text",
      "title": "\u067e\u06cc\u0627\u0645"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "pending",
        "reviewed",
        "accepted",
        "rejected"
      ],
      "default": "pending"
    }
  },
  "required": [
    "full_name",
    "email",
    "message"
  ]
}